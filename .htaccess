# Sirf do kaam - koi khatre wali cheez nahi. Baaki site par asar nahi.

<IfModule mod_mime.c>
  # Apache ko .mjs / .wasm ka pata nahi hota. In ke baghair model load hi nahi hoga.
  AddType text/javascript        .mjs
  AddType application/wasm       .wasm
  AddType application/octet-stream .onnx
</IfModule>

<IfModule mod_headers.c>
  # Model aur wasm kabhi kabhar hi badalte hain - browser ko kehdo saal bhar rakhe.
  <FilesMatch "\.(onnx|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Chhoti files (safha, script, lughat) — browser har baar poochh le: nayi hai ya nahi?
  # Isi liye site update hote hi sab ko turant nazar aati hai. Model (.onnx/.wasm) upar wale
  # niyam se saal bhar mehfooz rehta hai — dobara nahi utarta.
  <FilesMatch "\.(html|js|mjs|json|tsv|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

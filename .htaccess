# Sirf do kaam - koi khatre wali cheez nahi. Baaki site par asar nahi.

<IfModule mod_mime.c>
  # Apache ko .mjs / .wasm ka pata nahi hota. In ke baghair model load hi nahi hoga.
  AddType text/javascript        .mjs
  AddType application/wasm       .wasm
  AddType application/octet-stream .onnx
</IfModule>

<IfModule mod_headers.c>
  # Model aur wasm kabhi kabhar hi badalte hain - browser ko kehdo saal bhar rakhe.
  <FilesMatch "\.(onnx|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Chhoti files (safha, script, lughat) — browser har baar poochh le: nayi hai ya nahi?
  # Isi liye site update hote hi sab ko turant nazar aati hai. Model (.onnx/.wasm) upar wale
  # niyam se saal bhar mehfooz rehta hai — dobara nahi utarta.
  <FilesMatch "\.(html|js|mjs|json|tsv|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
<IfModule mod_setenvif.c>
  # farooqmusic.com ko sirf do engine files parhne ki ijazat (CORS).
  # Baaki poori site par koi asar nahi - sirf ye do files, sirf ye ek domain.
  <FilesMatch "^(uz-translit\.js|uz-lughat\.json)$">
    SetEnvIf Origin "^https?://(www\.)?farooqmusic\.com$" UZ_CORS=$0
    Header set Access-Control-Allow-Origin "%{UZ_CORS}e" env=UZ_CORS
    Header append Vary "Origin"
  </FilesMatch>
</IfModule>
</IfModule>


<IfModule mod_authz_core.c>
  # Kaghazat (uz-docs ki .md reports) website par nahi khulni chahiyen.
  <FilesMatch "\.md$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.md$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
